# ─────────────────────────────────────────────────────────────
# IDU Platform v2 — Environment (copy to .env and fill real values)
# NEVER commit .env. Secrets stay out of the codebase (§13).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (PostgreSQL) ──
POSTGRES_USER=idu
POSTGRES_PASSWORD=idu_dev_password
POSTGRES_DB=idu_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://idu:idu_dev_password@localhost:5432/idu_platform?schema=public

# ── Redis (cache / sessions / BullMQ / Socket.IO adapter) ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Object storage (S3 / MinIO) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=idu_minio
S3_SECRET_KEY=idu_minio_password
S3_BUCKET=idu-uploads
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Auth / JWT ──
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ── API ──
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── Telegram (Bot + Mini App) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Integrations (Phase 3+) ──
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@idu.uz

# ── Observability ──
SENTRY_DSN=
LOG_LEVEL=debug
